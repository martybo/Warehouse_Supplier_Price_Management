# Copy this file to .env and adjust values
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=warehouse_pricing
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Who will be recorded in product_mapping.approved_by
APP_APPROVER=mmcgranaghan

# Optional: prefix for batch ids; the app will append YYYYMMDD and a counter
BATCH_PREFIX=legacy_review

# Simple API token for local protection (must match the token in your .env)
API_TOKEN=change-me
